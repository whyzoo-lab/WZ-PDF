{
  /**
   * WZ PDF — electron-builder configuration
   *
   * Two Windows targets:
   *   - nsis     : Setup installer (fast startup, recommended for daily use,
   *                registers .pdf file association)
   *   - portable : Single-file exe (required by the "Viewer EXE export"
   *                feature, which appends PDF bytes to the portable exe via
   *                the PORTABLE_EXECUTABLE_FILE env var)
   */
  "appId": "com.wz.pdfeditor",
  "productName": "WZ PDF",
  "copyright": "WZ PDF",

  "directories": {
    "output": "release"
  },

  // Hook that bundles the portable EXE into the NSIS installer as
  // viewer-template.exe — see scripts/afterPack.cjs.
  "afterPack": "./scripts/afterPack.cjs",

  // Files bundled into the asar (renderer + compiled main process)
  // Files bundled into the asar (renderer + compiled main process).
  //
  // node_modules is EXCLUDED on purpose. electron-builder ships production
  // dependencies by default, but nothing here needs them at runtime: Vite has
  // already bundled every renderer dependency into dist/, and the main process
  // imports only `electron` plus Node built-ins. Shipping them anyway added
  // ~237 MB of exact duplicates to app.asar (@napi-rs/canvas native binaries,
  // @paddleocr, @techstark/opencv-js, @rhwp/core, pdfjs-dist …) — 3106 of the
  // asar's 3182 entries. That matters beyond disk: Windows opens app.asar on
  // every launch, and Defender scanning a 364 MB file on the first access after
  // a boot or an update is exactly the kind of intermittent multi-second
  // start-up stall it produced.
  //
  // If the main process ever does need a real runtime dependency, add it here
  // explicitly (e.g. "node_modules/some-pkg/**/*") rather than dropping the
  // exclusion.
  "files": [
    "dist/**/*",
    "electron/**/*.js",
    "!electron/**/*.test.js",
    "electron/package.json",
    "package.json",
    "!node_modules/**/*"
  ],

  // Keep the big, lazily-loaded binaries OUT of the asar. They are only read
  // when the user actually runs OCR / opens a HWP / renders a PDF, so leaving
  // them inside would put ~120 MB back into the one file that is opened (and
  // AV-scanned) at every launch. Node's fs transparently redirects reads from
  // app.asar/<path> to app.asar.unpacked/<path>, so the app:// handler needs no
  // change. Hashed filenames are matched by glob.
  "asarUnpack": [
    "dist/ocr/**",              // PP-OCR models (~56 MB)
    "dist/hwp/**",              // rhwp wasm (~5.7 MB)
    "dist/wasm/**",             // pdfjs image decoders
    "dist/assets/*.wasm",       // onnxruntime + rhwp wasm emitted by Vite
    "dist/assets/ocrEngine-*.js",
    "dist/assets/worker-entry-*.js"
  ],

  // Only bundle these Electron locales (drops ~50 unused ones, ~10MB saving)
  "electronLanguages": ["en-US", "ko"],

  // Maximum LZMA compression — smaller installer, slightly longer build time
  "compression": "maximum",

  // Register WZ PDF as a handler for .pdf files. The OS will pass the file
  // path as a CLI argument; main.ts picks it up via process.argv.
  // `icon` controls the icon shown for associated .pdf files in Explorer.
  // Every format the app can open is registered at install time, so a
  // double-clicked file reaches the app without the user wiring it up by hand.
  // Keep this list in step with DOCUMENT_EXTENSIONS in electron/security.ts —
  // registering an extension the runtime then refuses is worse than not
  // registering it, because the file opens the app to an empty window. The
  // security.test.ts case "registers only extensions the runtime will actually
  // open" fails the build if they drift.
  //
  // `name` becomes the Windows ProgID, not a label — verified in the registry,
  // where HKLM\Software\Classes\.pdf resolves to this file's "PDF Document".
  // New entries are therefore namespaced, so we cannot clobber (or be clobbered
  // by) another application that picks an obvious name like "PNG Image".
  // `.pdf` deliberately keeps its unprefixed ProgID: it is already registered on
  // every existing install and re-pointing a working association to fix a purely
  // theoretical collision is not worth the risk. `description` is the text
  // Explorer actually shows.
  //
  // This makes WZ PDF *available* for these types and gives them its icon;
  // Windows 10/11 still asks before changing an existing default, and no
  // installer can bypass that.
  "fileAssociations": [
    { "ext": "pdf",      "name": "PDF Document",  "description": "PDF Document",               "role": "Viewer", "icon": "build/icon.ico" },
    { "ext": "hwp",      "name": "WZPDF.hwp",     "description": "Hancom Office HWP Document", "role": "Viewer", "icon": "build/icon.ico" },
    { "ext": "hwpx",     "name": "WZPDF.hwpx",    "description": "Hancom Office HWPX Document","role": "Viewer", "icon": "build/icon.ico" },
    { "ext": "eml",      "name": "WZPDF.eml",     "description": "E-mail Message",             "role": "Viewer", "icon": "build/icon.ico" },
    { "ext": "md",       "name": "WZPDF.md",      "description": "Markdown Document",          "role": "Viewer", "icon": "build/icon.ico" },
    { "ext": "markdown", "name": "WZPDF.markdown","description": "Markdown Document",          "role": "Viewer", "icon": "build/icon.ico" },
    // Images open as one-page documents, so they belong here too. If owning
    // picture files ever feels intrusive, these six lines are the whole change.
    { "ext": "png",      "name": "WZPDF.png",     "description": "PNG Image",                  "role": "Viewer", "icon": "build/icon.ico" },
    { "ext": "jpg",      "name": "WZPDF.jpg",     "description": "JPEG Image",                 "role": "Viewer", "icon": "build/icon.ico" },
    { "ext": "jpeg",     "name": "WZPDF.jpeg",    "description": "JPEG Image",                 "role": "Viewer", "icon": "build/icon.ico" },
    { "ext": "gif",      "name": "WZPDF.gif",     "description": "GIF Image",                  "role": "Viewer", "icon": "build/icon.ico" },
    { "ext": "bmp",      "name": "WZPDF.bmp",     "description": "Bitmap Image",               "role": "Viewer", "icon": "build/icon.ico" },
    { "ext": "webp",     "name": "WZPDF.webp",    "description": "WebP Image",                 "role": "Viewer", "icon": "build/icon.ico" }
  ],

  // `build:exe` runs `electron-builder --win portable` then `--win nsis`
  // sequentially, so both targets are declared here but each invocation picks
  // exactly one. Sequencing matters: NSIS's afterPack hook needs the portable
  // artifact already on disk to bundle it as viewer-template.exe.
  // The hwp2pdf console launcher sits beside WZ PDF.exe (it locates the app
  // relative to itself). Built by scripts/build-cli.cjs; ~5 KB.
  "extraFiles": [
    { "from": "build/hwp2pdf.exe", "to": "hwp2pdf.exe" }
  ],

  // The MCP server ships as one bundled file plus the two pdfjs files it needs
  // (~6 MB). It runs on the app's own Electron binary via ELECTRON_RUN_AS_NODE,
  // so users need no Node install; hwp_to_pdf finds "WZ PDF.exe" two levels up
  // from here, which is why the destination path matters.
  // The explicit filter matters: without it electron-builder skips the nested
  // node_modules/ directory, and the server ships without the pdfjs files it
  // imports — it then dies on startup with "DOMMatrix is not defined".
  "extraResources": [
    { "from": "build/mcp", "to": "mcp", "filter": ["**/*"] }
  ],

  "win": {
    // build/icon.ico is generated from public/icon.svg by scripts/build-icon.cjs
    // (multi-resolution: 16/24/32/48/64/128/256). Used as the exe icon, taskbar
    // icon, and — together with `fileAssociations[].icon` — the .pdf file icon.
    "icon": "build/icon.ico",
    "target": [
      { "target": "nsis",     "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ]
  },

  "nsis": {
    // build/installer.nsh adds the install directory to the user's PATH, so
    // `hwp2pdf` runs from any terminal, and removes it again on uninstall.
    "include": "build/installer.nsh",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "WZ PDF",
    "artifactName": "WZ_PDF_Setup_${version}.exe",
    "deleteAppDataOnUninstall": false,
    // NSIS installer icon (also used for uninstaller) — same as the app icon.
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico"
  },

  "portable": {
    // PORTABLE_EXECUTABLE_FILE env-var is set by electron-builder to the path
    // of this exe — the app uses it to self-clone when exporting a viewer exe.
    "artifactName": "WZ_PDF_${version}.exe"
  }
}
