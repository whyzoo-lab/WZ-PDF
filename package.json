{
  "name": "wz-pdf",
  "private": true,
  "version": "1.18.0",
  "description": "Lightweight PDF viewer / editor with annotation, page management, multi-format export, and an MCP server. Built with React, Konva, pdfjs, pdf-lib, and Electron.",
  "license": "MIT",
  "author": "WhyZOO",
  "homepage": "https://github.com/whyzoo-lab/WZ-PDF",
  "repository": {
    "type": "git",
    "url": "https://github.com/whyzoo-lab/WZ-PDF.git"
  },
  "keywords": [
    "pdf",
    "viewer",
    "editor",
    "annotation",
    "watermark",
    "electron",
    "react",
    "mcp"
  ],
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "predev": "npm run setup:pdfjs && tsc -p tsconfig.electron.json",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "predev:vite": "npm run setup:pdfjs",
    "dev:vite": "vite",
    "build": "npm run setup:pdfjs && npm run setup:hwp && tsc -b && vite build",
    "build:icon": "node scripts/build-icon.cjs",
    "build:og": "node scripts/build-og.cjs",
    "setup:ocr": "python scripts/build-ocr-assets.py",
    "setup:hwp": "node scripts/copy-hwp-wasm.cjs",
    "setup:pdfjs": "node scripts/copy-pdfjs-wasm.cjs",
    "build:exe": "npm run build:cli && npm run build:mcp && npm run setup:pdfjs && npm run setup:hwp && npm run build:icon && tsc -p tsconfig.electron.json && tsc -b && vite build && electron-builder --win portable --publish never && electron-builder --win nsis --publish never",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "build:cli": "node scripts/build-cli.cjs",
    "build:mcp": "node scripts/build-mcp.cjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.9.1",
    "@paddleocr/paddleocr-js": "^0.3.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@rhwp/core": "0.8.2",
    "dompurify": "^3.4.12",
    "fft.js": "^4.0.4",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "marked": "^18.0.7",
    "onnxruntime-node": "^1.27.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7",
    "wait-on": "^8.0.1"
  }
}
