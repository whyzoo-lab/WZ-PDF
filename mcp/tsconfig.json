{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    // The repo root, not src/: docText.ts reuses the app's mail parser
    // (../src/services/emlParser.ts), so the build emits dist/mcp/src/… and
    // dist/src/services/emlParser.js. The shipped server is bundled by
    // scripts/build-mcp.cjs and does not depend on this layout.
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    // ../src/services/ooxmlText.ts imports jszip, and from there the lookup
    // reaches the repo root's node_modules — absent where only mcp/ is
    // installed (the CI job). Point it at this package's own copy; at run
    // time dist/src/services/ resolves upward to mcp/node_modules anyway.
    "paths": { "jszip": ["./node_modules/jszip"] }
  },
  "include": ["src/**/*", "../src/services/emlParser.ts", "../src/services/ooxmlText.ts"],
  // Tests run from source through the repo-root vitest; compiling them into
  // dist/ would ship vitest imports in the published server.
  "exclude": ["src/**/*.test.ts"]
}
