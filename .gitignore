# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Electron compiled outputs
electron/*.js
electron/*.js.map

# Build artifacts (electron-builder output)
release/
dist-exe/

# Generated app icon (regenerated by `npm run build:icon`)
build/

# Local deployment script — copy deploy.example.bat → deploy.bat and fill in
# your own server. Keeps internal hosts/paths out of the public repo.
deploy.bat

# Claude Code session data (launch configs, transcripts, allow-list) — local-only.
.claude/


# Bundled OCR model + wasm binaries (~56MB) — regenerate via: npm run setup:ocr
public/ocr/

# Bundled HWP WASM binary — regenerate via: npm run setup:hwp
public/hwp/

# Bundled pdfjs runtime assets (wasm decoders, CJK cmaps, standard fonts)
# — regenerate via: npm run setup:pdfjs
public/wasm/
public/cmaps/
public/standard_fonts/

# Superpowers SDD ledger (dev-only)
.superpowers/
build/hwp2pdf.exe

# build/ holds generated artifacts (icon, compiled CLI) EXCEPT the installer
# script, which is source electron-builder needs at pack time.
!build/installer.nsh
