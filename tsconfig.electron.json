{
  "compilerOptions": {
    "target": "ES2022",
    // Node16, not the removed node10. `electron/package.json` says
    // `{"type":"commonjs"}`, so this still emits require()/exports even though
    // the repo root is `"type": "module"` — which the main process depends on.
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "electron",
    "rootDir": "electron",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["electron/**/*"],
  "exclude": ["electron/**/*.js", "electron/**/*.test.ts"]
}
